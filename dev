#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
binary="$root/target/debug/omamail"

build_backend() {
  cargo build --locked \
    --manifest-path "$root/Cargo.toml" \
    --target-dir "$root/target" \
    --bin omamail
}

case "${1-}" in
  backend)
    build_backend
    printf 'Built %s\n' "$binary"
    ;;
  run)
    build_backend
    cat <<EOF
Built $binary

Development backend prepared; the installed private runtime was not changed.
OMAMAIL_BIN=$binary

Build and open the native development app with:
  make app-run
EOF
    ;;
  *)
    printf 'Usage: ./dev backend | run\n' >&2
    exit 2
    ;;
esac
